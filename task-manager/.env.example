# ─── Database (MySQL) ─────────────────────────────────────────────────────────
# Railway MySQL plugin sets this automatically
DB_URL=jdbc:mysql://localhost:3306/taskmanager?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password

# ─── Redis ────────────────────────────────────────────────────────────────────
# Railway Redis plugin sets this automatically
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
# Railway RabbitMQ plugin sets this automatically
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a secure random 64-char string for production
# e.g.: openssl rand -hex 32
JWT_SECRET=replace_with_a_very_long_random_secret_at_least_256_bits_long

# ─── Server ───────────────────────────────────────────────────────────────────
# Railway injects PORT automatically
PORT=8080
