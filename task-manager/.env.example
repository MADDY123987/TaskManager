# ─── Database (MySQL) ─────────────────────────────────────────────────────────
# Render/Railway MySQL connection string
DB_URL=jdbc:mysql://localhost:3306/taskmanager?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=no-reply@example.com

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a secure random 64-char string for production
# e.g.: openssl rand -hex 32
JWT_SECRET=replace_with_a_very_long_random_secret_at_least_256_bits_long

# ─── Frontend / CORS ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── S3 storage ──────────────────────────────────────────────────────────────
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_PATH_STYLE_ACCESS_ENABLED=false

# ─── Server ───────────────────────────────────────────────────────────────────
# Render/Railway inject PORT automatically
PORT=8080
